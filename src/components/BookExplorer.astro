---
import records from '../data/books.json';
import winners from '../data/book-winners.json';
import coverage from '../data/book-coverage.json';
import { groupBooks, selectBooks, defaults, institutions, selectionCount, renderSelectableBook, PAGE_SIZE } from '../lib/books';
import '../styles/books.css';
const groups = groupBooks(records);
const initial = selectBooks(groups, defaults);
const overlap = groups.filter(g => selectionCount(g.records) > 1).length;
const orgs = institutions(records);
const maxOverlap = Math.max(...groups.map(g => institutions(g.records).length));
---
<div class="books-page book-explorer">
      <div class="archive-stats"><span><strong>{groups.length.toLocaleString()}</strong>권</span><span><strong>{overlap}</strong>권이 2회 이상 선정</span><span><strong>{records.length.toLocaleString()}</strong>개 선정 기록</span><span class="stats-note">수록 선정처 <strong>{orgs.length}</strong>곳 · 한 책에 최대 <strong>{maxOverlap}</strong>곳</span></div>
      <nav class="view-tabs" aria-label="목록 보기"><button type="button" data-view="all" aria-pressed="true">전체 책 <span>{groups.length.toLocaleString()}</span></button><button type="button" data-view="overlap" aria-pressed="false">겹치는 책 <span>{overlap}</span></button><button type="button" data-view="selected" aria-pressed="false">선택한 책 <span id="selected-count">0</span></button><button type="button" data-view="winners" aria-pressed="false">연도별 1위</button></nav>
      <section id="browse-panel" aria-label="책 찾아보기">
        <form id="book-filters" role="search">
          <div class="search-line"><label class="search-field"><span class="field-label">검색</span><input id="book-query" name="query" type="search" placeholder="책 제목, 저자, 출판사, 추천자 검색" autocomplete="off" /></label></div>
          <div class="filter-line"><label><span>선정 연도</span><select name="year" id="book-year"><option value="">전체 연도</option>{Array.from({length:9},(_,i) => 2025-i).map(y => <option value={y}>{y}년</option>)}</select></label><label><span>선정처</span><select name="institution" id="book-institution"><option value="">전체 선정처</option>{orgs.map(org => <option>{org}</option>)}</select></label><label><span>선정 주체</span><select name="selector" id="book-selector"><option value="">전체 선정 주체</option><option value="writer">작가·소설가</option><option value="publisher">출판인</option><option value="reader">독자 투표</option><option value="expert">전문가·언론 편집부</option></select></label><button type="reset" class="reset-button">초기화</button></div>
        </form>
        <div class="results-bar"><p id="result-count" role="status" aria-live="polite"><strong>{groups.length.toLocaleString()}</strong>권 · {records.length.toLocaleString()}개 기록</p><label class="sort-label"><span class="sr-only">정렬</span><select id="book-sort"><option value="overlap">선정 횟수가 많은 순</option><option value="institutions">선정처가 많은 순</option><option value="latest">최근 선정 순</option><option value="title">제목 가나다순</option></select></label></div>
        <div class="selection-toolbar"><label><input type="checkbox" id="select-page" /> 이 페이지 선택</label><span id="selection-status" role="status" aria-live="polite">선택한 책 0권</span><button type="button" id="export-selected" disabled>선택한 책 CSV</button><button type="button" id="clear-selected" disabled>선택 모두 해제</button></div>
        <div class="list-heading" aria-hidden="true"><span>도서 / 저자·출판사</span><span>선정처 / 연도</span><span>선정 횟수</span></div>
        <div id="book-results" set:html={initial.slice(0,PAGE_SIZE).map(g => renderSelectableBook(g,g,false)).join('')} />
        <nav class="pagination" aria-label="도서 목록 페이지"><button id="prev-page" type="button" disabled>← 이전</button><span id="page-status">1 / {Math.ceil(groups.length/PAGE_SIZE)}</span><button id="next-page" type="button">다음 →</button></nav>
        <p class="count-note">선정 횟수는 연도·선정처·기획·부문별로 1회씩 셉니다. 같은 부문의 여러 추천은 1회로 묶으며, 모든 수치는 현재 검색 조건 기준입니다.</p>
        <noscript><p>전체 검색과 다음 페이지는 JavaScript를 켜면 사용할 수 있습니다. 모든 기록은 <a href="/books/records.csv" download>전체 CSV</a>에서도 볼 수 있습니다.</p></noscript>
      </section>
      <section id="winners-panel" aria-labelledby="winners-heading" hidden><div class="section-intro"><h2 id="winners-heading">같은 해, 서로 다른 선택</h2><p>교보문고의 소설가 설문과 YES24의 독자 투표를 나란히 봅니다. 공동 1위는 함께 표기했습니다.</p></div><div class="winner-grid"><div class="winner-head"><span>연도</span><span>교보문고 <small>소설가 선정</small></span><span>YES24 <small>독자 투표</small></span></div>{winners.map(w => <article class="winner-row"><h3>{w['선정연도']}</h3><div><span class="mobile-label">교보문고 · 소설가</span><a href={w['교보문고 출처URL']} target="_blank" rel="noopener noreferrer">{w['교보문고 소설가 선정 1위']} ↗</a></div><div><span class="mobile-label">YES24 · 독자</span><a href={w['YES24 출처URL']} target="_blank" rel="noopener noreferrer">{w['YES24 독자 선정 1위']} ↗</a></div></article>)}</div></section>
      <slot />
      <details class="coverage"><summary>선정처별 수록 범위와 집계 방법 <span>확인하기 +</span></summary><div class="coverage-content"><p>연도는 책의 출간 연도가 아닌 <strong>선정 연도</strong>입니다. 확인한 원문을 수록했으며, 모든 선정처의 9개년 전체 목록을 망라하지는 않습니다.</p><ul><li>같은 제목과 저자를 기준으로 묶었습니다. 권수·세트는 구분하며, 번역자나 원문 표기는 각 선정 내역에서 확인할 수 있습니다.</li><li>자사 추천·타사 추천·독자 투표·언론 편집부 선정을 구분해 표시합니다. 다른 선정처의 결과를 보도한 매체는 별도 선정처로 세지 않습니다. 같은 해 같은 기획의 작가 추천·자사 추천·타사 추천·독자 투표는 각각 1회로 셉니다. 같은 부문의 개별 추천과 집계 결과는 한 번만 셉니다. 기록 수는 원자료 항목 수이며 합산 득표가 아닙니다.</li><li>선정처별로 수록 연도와 공개 목록의 범위가 다릅니다. 아래 표에서 선정 주체와 확인한 범위를 함께 볼 수 있습니다.</li></ul><div class="coverage-table"><table><thead><tr><th>연도</th><th>선정처 / 선정 주체</th><th>수록 범위</th><th>한계·비고</th></tr></thead><tbody>{coverage.map(c => <tr><td>{c['선정연도']}</td><td>{c['대표 출처URL'] ? <a href={c['대표 출처URL']} target="_blank" rel="noopener noreferrer">{c['주관기관']} ↗</a> : c['주관기관']}<small>{c['선정주체']}</small></td><td>{c['수록 범위']}<small>{c['수록 행 수']}개 기록</small></td><td>{c['한계·비고']}</td></tr>)}</tbody></table></div></div></details>

</div>
<script src="../scripts/books.ts"></script>
